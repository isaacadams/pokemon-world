{
   "compilerOptions": {
      "target": "ES6",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "lib": ["DOM", "es2017"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "./dist",
      "sourceMap": true,
      "types": ["bun"],
      "typeRoots": ["./node_modules/@types", "src/types", "../../node_modules/@types"],
      "paths": {
         "@assets/*": ["./src/assets/*"],
         "@config/*": ["./src/config/*"],
         "@game/*": ["./src/game/*"]
      }
   },
   "include": ["src/**/*"],
   "exclude": ["node_modules"]
}
