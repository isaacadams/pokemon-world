{
   "name": "@pokemon-world/root",
   "private": true,
   "description": "A Pokemon exploration web app using PixiJS",
   "author": "Isaac Adams",
   "license": "ISC",
   "packageManager": "bun@1.4.4",
   "workspaces": ["apps/*", "packages/*", "infra", "test"],
   "scripts": {
      "fresh-install": "find . -name node_modules -type d -prune -exec rm -rf {} + && rm -f bun.lock && bun install",
      "build": "bun run --filter '*' build",
      "typecheck": "bun run --filter '*' typecheck",
      "test": "bun test ./apps ./infra ./test/unit",
      "test:dst": "bun run --filter @repo/dst test",
      "test:e2e": "bun run --filter @repo/e2e test",
      "format": "prettier -w '**/*.{ts,js}'",
      "dev": "bun run --filter @pokemon-world/game dev",
      "start:dev": "bun packages/dst/scripts/run-scenario.js --client --devmode --duration 86400",
      "deploy": "bun run --filter @repo/infra deploy"
   },
   "devDependencies": {
      "@types/bun": "^1.2.0",
      "prettier": "^3.5.3",
      "typescript": "^5.8.2"
   },
   "overrides": {
      "pixi.js": "7.4.0",
      "zod": "3.24.2"
   }
}
